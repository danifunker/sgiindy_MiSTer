scratch/
.DS_Store
._*

# roms/ holds SGI boot PROM images. They are SGI-copyrighted firmware and are
# committed here at the repository owner's decision; the core still loads one
# from the SD card at runtime rather than embedding it, so a fork that would
# rather not carry them can delete the directory without touching the RTL.

# Bulky derived artefacts (PROM disassembly, chip specs, MAME sources).
# Kept locally as working reference; not part of the core.
reference/

# Quartus build residue: build_id.v is regenerated by sys/build_id.tcl on every
# compile and jtag.cdf is written when the programmer is opened.
build_id.v
jtag.cdf

# Quartus / Verilator output
db/
incremental_db/
output_files/
simulation/
greybox_tmp/
obj_dir/
obj_dir_gui/
obj_dir_dmadbg/
# Per-user ImGui window layout, written to whatever directory the GUI
# harness is launched from.
imgui.ini
*.qws
*.rpt
*.summary
*.smsg
*.sof
*.pof
*.jdi
*.pin
*.done
# Quartus writes this when it crashes with an internal error.
cr_ie_info.json
*.log
*.fst
*.vcd
tests/out/
rtl/cpu/generated/

# Test disk images are generated, not tracked.
tests/disks/

# a scratch install target; 2 GB sparse, not something to track
disks/

# The VC2 timing generator unit test builds into its own directory.
verilator/obj_dir_vc2/
# So does the simulator with REX3's per-command trace compiled in, and the one
# with the Display Control Bus traced.
verilator/obj_dir_rex3dbg/
verilator/obj_dir_dcbdbg/
verilator/obj_dir_cmapdbg/
# The DDR3 mux and the frame buffer line cache each build their own.
verilator/obj_dir_ddr3/
verilator/obj_dir_lcache/
# And the rasteriser's standalone back-pressure test.
verilator/obj_dir_rex3/

# Machine-specific deploy configuration: host, ssh key, Quartus path.
# scripts/local.env.sample is the committed template.
scripts/local.env

# The full-flow Quartus logs written by scripts/build.sh (*.log is already
# ignored above; stderr is not).
build_*.err

# Quartus writes this beside the project when it builds the pin model.
c5_pin_model_dump.txt

scratch/
.DS_Store
._*

# roms/ holds SGI boot PROM images. They are SGI-copyrighted firmware and are
# committed here at the repository owner's decision; the core still loads one
# from the SD card at runtime rather than embedding it, so a fork that would
# rather not carry them can delete the directory without touching the RTL.

# Bulky derived artefacts (PROM disassembly, chip specs, MAME sources).
# Kept locally as working reference; not part of the core.
reference/

# Quartus / Verilator output
db/
incremental_db/
output_files/
simulation/
greybox_tmp/
obj_dir/
obj_dir_gui/
obj_dir_dmadbg/
# Per-user ImGui window layout, written to whatever directory the GUI
# harness is launched from.
imgui.ini
*.qws
*.rpt
*.summary
*.smsg
*.sof
*.pof
*.jdi
*.pin
*.done
# Quartus writes this when it crashes with an internal error.
cr_ie_info.json
*.log
*.fst
*.vcd
tests/out/
rtl/cpu/generated/

# Test disk images are generated, not tracked.
tests/disks/

# a scratch install target; 2 GB sparse, not something to track
disks/

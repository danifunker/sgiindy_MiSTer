# Copy to scripts/local.env and fill in. local.env is gitignored: this
# repository carries no machine addresses, keys or personal paths.
#
#   cp scripts/local.env.sample scripts/local.env && $EDITOR scripts/local.env

# The MiSTer to deploy to, and the ssh identity that reaches it as root.
export MISTER_HOST="MiSTer.local"
export MISTER_SSH_KEY="$HOME/.ssh/mister"
export MISTER_SSH_USER="root"

# The mrext "MiSTer Remote" HTTP/websocket API. Its Scripts entry must be
# running on the MiSTer for deploy/screenshot to work at all.
export MISTER_HTTP_PORT="8182"

# Which top-level "_" folder the core is pushed into and launched from. The
# OSD row is computed from the live listing, so any folder works - but the
# navigation is BLIND (the screenshot API does not capture the OSD) and every
# row is one more keystroke that can be dropped. A folder holding only the
# core under test is one `down`; _Computer is about fifty-five. Use a small
# folder for bring-up and _Computer for a release.
export MISTER_CORE_FOLDER="_Unstable"

# Where Quartus lives, for scripts/build.sh. Git-Bash style path.
export QUARTUS_BIN="/c/intelFPGA_lite/17.0/quartus/bin64"

# Project identity. GAMES_DIR is the name MiSTer derives from CONF_STR's first
# field - it is where the framework looks for boot.rom, and it must match
# `"SGIIndy;;"` in sgiindy.sv or the PROM will not be uploaded.
export PROJECT_NAME="sgiindy"
export RBF_NAME="sgiindy.rbf"      # Quartus output, output_files/
export RBF_REMOTE="SGIIndy.rbf"     # the name it is filed under on the MiSTer
export MISTER_GAMES_DIR="SGIIndy"
